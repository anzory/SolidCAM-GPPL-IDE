{
  "name": "vscode-gppl-ide",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "1.5.0",
  "publisher": "anzory",
  "author": {
    "name": "Andrey Zorin"
  },
  "icon": "images/icon.png",
  "license": "SEE LICENSE IN LICENSE",
  "repository": {
    "type": "git",
    "url": "https://github.com/anzory/SolidCAM-GPPL-IDE"
  },
  "l10n": "./l10n",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Linters",
    "Snippets"
  ],
  "keywords": [
    "gppl",
    "solidcam",
    "postprocessor",
    "cnc",
    "gpp"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:gppl",
    "onCommand:solidcam-gppl.activatePro"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "partial",
      "description": "%capabilities.untrustedWorkspaces.description%"
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "gppl",
        "aliases": [
          "GPPL",
          "SolidCAM GPPL",
          "General Post Processor Language"
        ],
        "extensions": [
          ".gpp"
        ],
        "icon": {
          "light": "./images/icon.png",
          "dark": "./images/icon.png"
        },
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "gppl",
        "scopeName": "source.gppl",
        "path": "./syntaxes/gppl.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "gppl",
        "path": "./snippets/gppl.code-snippets"
      }
    ],
    "configuration": {
      "type": "object",
      "title": "%configuration.title%",
      "properties": {
        "solidcam-gppl.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "%configuration.trace.description%"
        },
        "gppl.encoding": {
          "type": "string",
          "enum": [
            "windows1252",
            "windows1251"
          ],
          "enumDescriptions": [
            "%configuration.encoding.windows1252%",
            "%configuration.encoding.windows1251%"
          ],
          "default": "windows1252",
          "description": "%configuration.encoding.description%"
        },
        "solidcam-gppl.proRequestEmail": {
          "type": [
            "string",
            "null"
          ],
          "default": null,
          "scope": "application",
          "description": "%configuration.proRequestEmail.description%"
        },
        "solidcam-gppl.proRequestUrl": {
          "type": [
            "string",
            "null"
          ],
          "default": "https://functions.yandexcloud.net/d4eeskqsgg3jkh0a2cpc",
          "scope": "application",
          "description": "%configuration.proRequestUrl.description%"
        },
        "solidcam-gppl.proRequestToken": {
          "type": [
            "string",
            "null"
          ],
          "default": "47c96004-f717-4186-bfa6-8648b8ad5981",
          "scope": "application",
          "description": "%configuration.proRequestToken.description%"
        },
        "solidcam-gppl.workspace.maxFiles": {
          "type": "integer",
          "default": 5000,
          "description": "%configuration.workspace.maxFiles.description%"
        },
        "solidcam-gppl.workspace.excludeGlobs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "**/node_modules/**",
            "**/.git/**",
            "**/bin/**",
            "**/obj/**",
            "**/dist/**",
            "**/out/**"
          ],
          "description": "%configuration.workspace.excludeGlobs.description%"
        }
      }
    },
    "configurationDefaults": {
      "[gppl]": {
        "editor.semanticHighlighting.enabled": true,
        "files.encoding": "windows1252",
        "files.autoGuessEncoding": false
      },
      "editor.semanticTokenColorCustomizations": {
        "rules": {
          "variable.readonly.defaultLibrary:gppl": {
            "fontStyle": "italic"
          },
          "variable.readonly.defaultLibrary.boolean:gppl": {
            "fontStyle": "italic underline"
          },
          "keyword.interrupt:gppl": {
            "foreground": "#ff4444"
          }
        }
      }
    },
    "semanticTokenScopes": [
      {
        "language": "gppl",
        "scopes": {
          "variable": [
            "variable.other.gppl"
          ],
          "variable.declaration": [
            "variable.other.declaration.gppl"
          ],
          "variable.readonly": [
            "variable.other.constant.gppl"
          ],
          "function": [
            "entity.name.function.gppl"
          ],
          "function.declaration": [
            "entity.name.function.definition.gppl"
          ],
          "parameter": [
            "variable.parameter.gppl"
          ],
          "parameter.declaration": [
            "variable.parameter.declaration.gppl"
          ],
          "namespace": [
            "entity.name.namespace.gppl"
          ],
          "class": [
            "entity.name.type.class.gppl"
          ]
        }
      }
    ],
    "commands": [
      {
        "command": "solidcam-gppl.openLogs",
        "title": "%command.openLogs.title%",
        "category": "SolidCAM GPPL"
      },
      {
        "command": "solidcam-gppl.activatePro",
        "title": "%command.activatePro.title%",
        "category": "SolidCAM GPPL"
      },
      {
        "command": "solidcam-gppl.refreshProLicense",
        "title": "%command.refreshProLicense.title%",
        "category": "SolidCAM GPPL"
      },
      {
        "command": "solidcam-gppl.createProjectFile",
        "title": "%command.createProjectFile.title%",
        "category": "SolidCAM GPPL"
      },
      {
        "command": "solidcam-gppl.refreshProjectExplorer",
        "title": "%command.refreshProjectExplorer.title%",
        "category": "SolidCAM GPPL"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "solidcam-gppl.projectExplorer",
          "name": "%view.projectExplorer.title%",
          "when": "solidcam-gppl.proActive"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "solidcam-gppl.openLogs"
        },
        {
          "command": "solidcam-gppl.activatePro"
        },
        {
          "command": "solidcam-gppl.refreshProLicense"
        },
        {
          "command": "solidcam-gppl.createProjectFile",
          "when": "solidcam-gppl.proActive"
        },
        {
          "command": "solidcam-gppl.refreshProjectExplorer",
          "when": "solidcam-gppl.proActive"
        }
      ],
      "view/title": [
        {
          "command": "solidcam-gppl.refreshProjectExplorer",
          "when": "view == solidcam-gppl.projectExplorer",
          "group": "navigation"
        }
      ]
    }
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
